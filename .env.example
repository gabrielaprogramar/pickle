# ── Poseidon Ledger ─────────────────────────────────────────────
# Copy this file to .env.local and fill in values as needed.
#
# Both modules run fully mocked by default — no secrets required to compile,
# boot, or run the unit tests. Going live for either one is a matter of
# setting the variables below and flipping USE_MOCK=false.

# ── MarineTraffic Module (Phase 1A) ─────────────────────────────
# Set to "false" to use the real MarineTraffic API. Default: "true" (mocked).
MARINETRAFFIC_USE_MOCK=true

# 40-char hex MarineTraffic API key. Required only when USE_MOCK=false.
# MARINETRAFFIC_API_KEY=

# ── Optional overrides (safe defaults provided) ─────────────────
# MARINETRAFFIC_BASE_URL=https://services.marinetraffic.com/api
# MARINETRAFFIC_TIMEOUT_MS=10000
# MARINETRAFFIC_RATE_LIMIT_PER_MIN=30
# MARINETRAFFIC_MAX_RETRIES=3

# ── Supabase Module (Phase 1B) ──────────────────────────────────
# When true (default), the Supabase client is built with placeholder
# credentials. The module imports cleanly and repository unit tests run
# (they inject an in-memory fake client). No network access occurs.
SUPABASE_USE_MOCK=true

# Supabase project URL. Required when SUPABASE_USE_MOCK=false.
# Example: https://xxxx.supabase.co
# SUPABASE_URL=

# Service role key — SERVER ONLY, bypasses Row-Level Security.
# NEVER expose this key to the browser. Required when SUPABASE_USE_MOCK=false.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Optional override (safe default: "public") ──────────────────
# SUPABASE_SCHEMA=public

# ── Storage Module (Phase 2A.2) ────────────────────────────────
# When true (default), uses an in-memory mock storage. No Supabase Storage
# credentials required. Set to "false" for real file persistence.
STORAGE_USE_MOCK=true

# Supabase Storage bucket name. Default: "documents".
# STORAGE_BUCKET=documents

# ── OCR Module (Phase 2A.2) ────────────────────────────────────
# When true (default), uses a deterministic mock OCR provider with fixture
# data. No external OCR service required. Set to "false" for real OCR.
OCR_USE_MOCK=true

# ── AI Extraction Module (Phase 2A.3) ─────────────────────────
# When true (default), uses a deterministic mock AI provider with fixture
# data. No OpenAI API key required. Set to "false" for real GPT-4o extraction.
AI_USE_MOCK=true

# OpenAI API key. Required when AI_USE_MOCK=false.
# OPENAI_API_KEY=

# OpenAI model to use for extraction. Default: "gpt-4o".
# OPENAI_MODEL=gpt-4o

# ── Validation Module (Phase 2A.4) ─────────────────────────────
# When true (default), uses a deterministic mock validation provider with
# fixture data. No real validation logic executed. Set to "false" for real
# rules-based validation.
VALIDATION_USE_MOCK=true
